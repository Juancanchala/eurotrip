# Variables de entorno. Se configuran SOLO en Netlify:
# Site configuration → Environment variables. Nunca se suben al repositorio.

# Obligatoria para el asistente
OPENAI_API_KEY=

# Opcionales
OPENAI_MODEL=gpt-4.1-mini        # cualquier modelo de chat con function calling
OPENAI_MAX_TOKENS=700            # tope de tokens por respuesta (máx. 2000)
OPENAI_REASONING_EFFORT=         # solo para modelos de razonamiento: low | medium | high
AGENT_DEADLINE_MS=24000          # tiempo máximo por pregunta

# Clave de acceso de la familia (vacía = sin clave). Protege el asistente.
APP_ACCESS_KEY=
